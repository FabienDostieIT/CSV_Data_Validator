{
  "name": "csv-data-validator",
  "version": "1.0.0",
  "description": "Tool for validating CSV data against predefined JSON schemas.",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "node scripts/copy-templates.mjs",
    "validate-schema:2020": "ajv validate -s",
    "validate-schema:2019": "ajv validate -s",
    "validate-schema:7": "ajv validate -s",
    "clean": "rm -rf .next",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "prepare": "husky install",
    "prettier": "prettier --write .",
    "test": "jest",
    "e2e": "playwright test",
    "export": "next export"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-aspect-ratio": "^1.1.3",
