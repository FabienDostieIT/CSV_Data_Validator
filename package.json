    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv-cli": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "babel-jest": "^29.7.0",
    "eslint": "^9.24.0",
    "eslint-config-next": "^15.2.4",
    "fs-extra": "^11.3.0",
    "husky": "^9.1.7",
    "jest-environment-jsdom": "^29.7.0",
    "json-schema-static-docs": "^0.28.1",
    "lint-staged": "^15.5.1",
